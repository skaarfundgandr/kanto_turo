{
	"name": "cubetech-assessment-frontend",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "bun run preview",
		"preview": "bun run build && wrangler dev",
		"deploy": "bun run build && wrangler deploy --keep-vars",
		"cf-typegen": "wrangler types",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:unit": "vitest run",
		"api:types": "bun scripts/sync-api-types.mjs",
		"demo:seed": "bun scripts/seed_db.mjs"
	},
	"dependencies": {
		"@fontsource/archivo": "^5.3.0",
		"@fontsource/bungee": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/kalam": "^5.3.0",
		"@sveltejs/kit": "^2.70.2",
		"qrcode": "^1.5.4"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@testing-library/svelte": "^5.4.2",
		"@types/qrcode": "^1.5.6",
		"axe-core": "^4.13.0",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.9.0",
		"happy-dom": "^20.11.2",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.5",
		"typescript": "^5.9",
		"typescript-eslint": "^8.66.0",
		"vite": "^8.2.1",
		"vitest": "^4.1.10",
		"wrangler": "^4.122.0"
	}
}
