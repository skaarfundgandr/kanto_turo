# ============================================================================
# Frontend environment (SvelteKit SPA)
# ============================================================================

# Base URL of the Arrow Server API.
# Must be an absolute http(s) URL ending in /api/v1, with no trailing slash,
# extra path, query string, or hash. A malformed value makes the app fail
# fast with a clear development error.
# The app reads this through SvelteKit's $env/dynamic/public module. In a
# Cloudflare Workers deployment, configure it as a plain-text Worker variable;
# it is public client configuration, not a secret.
# Defaults to the local backend when unset.
PUBLIC_API_BASE_URL=http://127.0.0.1:3000/api/v1
